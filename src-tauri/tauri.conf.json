{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/config.schema.json",
  "productName": "TunnelDock",
  "mainBinaryName": "TunnelDock",
  "version": "../version.json",
  "identifier": "io.github.t59688.tunneldock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:11420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TunnelDock — OpenAI Tunnel & Pi Workspace",
        "width": 1380,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5RDQyQzIwOEI5MzIyODAKUldTQUlwT0xJQ3pVNlJCWEJFRGVJSHdmWmovZHBYazRxNWNvWVJkMXhTdkp3aEV6N0pCeldZUXYK",
      "endpoints": [
        "https://github.com/LPL-far/tunneldock/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
